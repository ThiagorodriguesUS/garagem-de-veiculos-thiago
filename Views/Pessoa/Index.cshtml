@model List<Pessoa>
@{ViewData["Title"]="Pessoas";}<div class="heading"><div><p class="eyebrow">CADASTROS</p><h1>Pessoas</h1></div><a class="button" asp-action="Create">+ Nova pessoa</a></div>
<div class="panel"><table><thead><tr><th>Nome</th><th>CPF</th><th>E-mail</th><th>Telefone</th><th></th></tr></thead><tbody>@foreach(var p in Model){<tr><td>@p.Nome</td><td>@p.CPF</td><td>@p.Email</td><td>@p.Telefone</td><td class="actions"><a asp-action="Edit" asp-route-id="@p.Id">Editar</a><form asp-action="Delete" asp-route-id="@p.Id" method="post" onsubmit="return confirm('Excluir esta pessoa?')"><button class="link danger" type="submit">Excluir</button></form></td></tr>}@if(Model.Count==0){<tr><td colspan="5" class="empty">Nenhuma pessoa cadastrada.</td></tr>}</tbody></table></div>
