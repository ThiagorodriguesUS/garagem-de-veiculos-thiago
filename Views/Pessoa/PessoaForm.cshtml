@model Pessoa
@{var edit=Model.Id>0;ViewData["Title"]=edit?"Editar pessoa":"Nova pessoa";}<div class="heading"><div><p class="eyebrow">CADASTROS / PESSOAS</p><h1>@ViewData["Title"]</h1></div></div><form class="panel form" asp-action="@(edit?"Edit":"Create")" method="post">@if(edit){<input asp-for="Id" type="hidden"/>}<div asp-validation-summary="ModelOnly" class="validation"></div><label asp-for="Nome"></label><input asp-for="Nome"/><span asp-validation-for="Nome" class="validation"></span><label asp-for="CPF"></label><input asp-for="CPF" placeholder="000.000.000-00"/><span asp-validation-for="CPF" class="validation"></span><label asp-for="Email">E-mail</label><input asp-for="Email"/><span asp-validation-for="Email" class="validation"></span><label asp-for="Telefone"></label><input asp-for="Telefone"/><div class="form-actions"><a class="button secondary" asp-action="Index">Voltar</a><button class="button" type="submit">Salvar</button></div></form>
