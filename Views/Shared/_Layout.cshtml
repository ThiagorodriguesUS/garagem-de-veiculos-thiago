<!doctype html><html lang="pt-br"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] - Garagem</title><link rel="stylesheet" href="~/css/site.css" /></head><body><header><a class="brand" asp-controller="Reserva" asp-action="Index">Garagem de Veículos</a><nav><a asp-controller="Reserva" asp-action="Index">Reservas</a><a asp-controller="Pessoa" asp-action="Index">Pessoas</a><a asp-controller="Veiculo" asp-action="Index">Veículos</a></nav></header><main>@if(TempData["Erro"] is string e){<div class="alert error">@e</div>}@if(TempData["Sucesso"] is string s){<div class="alert success">@s</div>}@RenderBody()</main><footer>Projeto acadêmico · Arquitetura MVC + Repository</footer></body></html>
