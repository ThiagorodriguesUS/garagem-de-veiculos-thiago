@model List<Veiculo>
@{ViewData["Title"]="Veículos";}<div class="heading"><div><p class="eyebrow">CADASTROS</p><h1>Veículos</h1></div><a class="button" asp-action="Create">+ Novo veículo</a></div><div class="panel"><table><thead><tr><th>Placa</th><th>Marca / Modelo</th><th>Ano</th><th>Cor</th><th></th></tr></thead><tbody>@foreach(var v in Model){<tr><td><strong>@v.Placa</strong></td><td>@v.Marca @v.Modelo</td><td>@v.Ano</td><td>@v.Cor</td><td class="actions"><a asp-action="Edit" asp-route-id="@v.Id">Editar</a><form asp-action="Delete" asp-route-id="@v.Id" method="post" onsubmit="return confirm('Excluir este veículo?')"><button class="link danger" type="submit">Excluir</button></form></td></tr>}@if(Model.Count==0){<tr><td colspan="5" class="empty">Nenhum veículo cadastrado.</td></tr>}</tbody></table></div>
