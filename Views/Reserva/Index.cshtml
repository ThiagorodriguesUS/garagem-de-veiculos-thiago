@model List<Reserva>
@{ViewData["Title"]="Reservas";var pessoas=(List<Pessoa>)ViewBag.Pessoas;var veiculos=(List<Veiculo>)ViewBag.Veiculos;var hoje=(DateOnly)ViewBag.Hoje;}
<div class="heading"><div><p class="eyebrow">PAINEL DA GARAGEM</p><h1>Reservas</h1><p class="muted">Gerencie períodos e acompanhe a disponibilidade dos veículos.</p></div></div>
<section class="panel form"><h2>Nova reserva</h2>@if(pessoas.Count==0||veiculos.Count==0){<p class="muted">Cadastre ao menos uma pessoa e um veículo para reservar.</p>}else{<form asp-action="Create" method="post" class="grid-form"><div><label for="VeiculoId">Veículo</label><select id="VeiculoId" name="VeiculoId" required><option value="">Selecione</option>@foreach(var v in veiculos){<option value="@v.Id">@v.Placa · @v.Marca @v.Modelo</option>}</select></div><div><label for="PessoaId">Pessoa</label><select id="PessoaId" name="PessoaId" required><option value="">Selecione</option>@foreach(var p in pessoas){<option value="@p.Id">@p.Nome</option>}</select></div><div><label for="DataInicio">Início</label><input id="DataInicio" name="DataInicio" type="date" required/></div><div><label for="DataFim">Fim</label><input id="DataFim" name="DataFim" type="date" required/></div><button class="button" type="submit">Criar reserva</button></form>}</section>
<div class="heading compact"><div><h2>Períodos reservados</h2></div></div><div class="panel"><table><thead><tr><th>Veículo</th><th>Pessoa</th><th>Período</th><th>Status hoje</th><th>Ações</th></tr></thead><tbody>@foreach(var r in Model){var v=veiculos.FirstOrDefault(x=>x.Id==r.VeiculoId);var p=pessoas.FirstOrDefault(x=>x.Id==r.PessoaId);<tr><td>@(v is null?"Veículo removido":$"{v.Placa} · {v.Marca} {v.Modelo}")</td><td>@(p?.Nome??"Pessoa removida")</td><td>@r.DataInicio.ToString("dd/MM/yyyy") – @r.DataFim.ToString("dd/MM/yyyy")</td><td>@if(hoje>=r.DataInicio&&hoje<=r.DataFim){<span class="badge reserved">Reservado</span>}else{<span class="badge available">Disponível</span>}</td><td><details><summary>Editar período</summary><form asp-action="Edit" method="post" class="inline-form"><input type="hidden" name="id" value="@r.Id"/><label>Início<input name="dataInicio" type="date" value="@r.DataInicio.ToString("yyyy-MM-dd")" required/></label><label>Fim<input name="dataFim" type="date" value="@r.DataFim.ToString("yyyy-MM-dd")" required/></label><button class="button small" type="submit">Salvar</button></form></details><form asp-action="Delete" method="post" onsubmit="return confirm('Cancelar esta reserva?')"><input type="hidden" name="id" value="@r.Id"/><button class="link danger" type="submit">Cancelar</button></form></td></tr>}@if(Model.Count==0){<tr><td colspan="5" class="empty">Nenhuma reserva cadastrada.</td></tr>}</tbody></table></div>
